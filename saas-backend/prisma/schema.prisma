generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// CONTROL DE LÍMITES PERSONALIZADOS POR NEGOCIO (SaaS Directo)
// ==============================================================

model NegocioLimite {
  id         String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String @unique @db.Char(36) // Relación 1-a-1 estricta

  // Límites numéricos acordados (Usa -1 para representar "Ilimitado")
  max_usuarios          Int @default(3)
  max_sucursales        Int @default(1)
  max_productos         Int @default(100)
  max_variantes         Int @default(800)
  max_vehiculos         Int @default(1000)
  max_cajas             Int @default(2)
  max_cuentas_bancarias Int @default(2)

  storage_bytes_used BigInt? @default(0)
  storage_max_bytes  BigInt? @default(5368709120)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)

  @@map("negocio_limites")
}

// ==============================================================
// ADICIÓN: GEOGRAFÍA E INTERNACIONALIZACIÓN (GLOBAL)
// ==============================================================

model Pais {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  codigo_iso String   @unique // Ej: "GT", "MX", "HN", "US"
  nombre     String   @db.VarChar(100)
  codigo_tel String   @db.VarChar(10) // Ej: "+502", "+52"
  moneda_id  String   @db.Char(36)
  locale     String?  @db.VarChar(10) // Ej: "es-GT", "es-MX", "en-US"
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  moneda          Moneda           @relation(fields: [moneda_id], references: [id])
  negocios        Negocio[]
  divisionNivel1s DivisionNivel1[]

  @@map("paises")
}

// ==============================================================
// DIVISIONES POLÍTICAS / ADMINISTRATIVAS (UNIVERSAL)
// Nivel 1: Departamentos (GT, CO), Estados (MX, US), Provincias (ES, AR), Regiones (CL)
// Nivel 2: Municipios (GT, MX), Ciudades/Condados (US), Cantones (CR), Comunas (CL)
// ==============================================================

model DivisionNivel1 {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  pais_id    String   @db.Char(36)
  nombre     String   @db.VarChar(100) // Ej. "Guatemala", "Quetzaltenango", "Jalisco"
  codigo_iso String?  @db.VarChar(10) // Ej. "GT-GU", "GT-QZ", "MX-JAL"
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pais               Pais             @relation(fields: [pais_id], references: [id], onDelete: Cascade)
  divisiones_nivel_2 DivisionNivel2[]

  @@unique([pais_id, nombre])
  @@map("divisiones_nivel1")
}

model DivisionNivel2 {
  id                 String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  division_nivel1_id String   @db.Char(36)
  nombre             String   @db.VarChar(100) // Ej. "Guatemala", "Mixco", "Villa Nueva"
  codigo_postal      String?  @db.VarChar(10) // Ej. "01001", "01057", "01064"
  activo             Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  division_nivel_1 DivisionNivel1 @relation(fields: [division_nivel1_id], references: [id], onDelete: Cascade)
  sucursales       Sucursal[]

  @@unique([division_nivel1_id, nombre])
  @@map("divisiones_nivel2")
}

model Moneda {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  codigo     String   @unique // Ej: "GTQ", "USD", "MXN", "HNL"
  nombre     String   @db.VarChar(50)
  simbolo    String   @db.VarChar(10) // Ej: "Q", "$", "L"
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  paises               Pais[]
  cuentas_bancarias    CuentaBancaria[]
  transacciones        Transaccion[]
  transacciones_origen Transaccion[]    @relation("MonedaActual")
  negocios             Negocio[]

  @@map("monedas")
}

// ==============================================================
// 1. NÚCLEO SAAS, MÓDULOS Y AUTENTICACIÓN
// ==============================================================

model Modulo {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  permisos Permiso[]
  negocios Negocio[]

  @@map("modulos")
}

model Permiso {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  modulo_id   String   @db.Char(36)
  codigo      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  modulo   Modulo    @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  roles    Rol[]     @relation("RolPermisos")
  negocios Negocio[] @relation("NegocioPermisos")

  @@map("permisos")
}

model Negocio {
  id                     String    @id @default(dbgenerated("(UUID())")) @db.Char(36)
  pais_id                String?   @db.Char(36)
  moneda_id              String?   @db.Char(36)
  nombre                 String
  codigo                 String?   @db.VarChar(10)
  slug                   String    @unique
  nombre_comercial       String    @db.VarChar(100)
  wa_id                  String    @unique(map: "wa_id") @db.VarChar(20)
  nit_rut                String?   @db.VarChar(20)
  logo_url               String?   @db.Text
  slogan                 String?   @db.VarChar(255)
  datos_facturacion_json Json?
  primary_color          String?   @db.VarChar(7)
  secondary_color        String?   @db.VarChar(7)
  instagram_id           String?   @db.VarChar(100)
  facebook_id            String?   @db.VarChar(100)
  activo                 Boolean   @default(true)
  fecha_registro         DateTime? @default(now()) @db.Timestamp(0)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  modulos                  Modulo[]
  permisos                 Permiso[]                 @relation("NegocioPermisos")
  sucursales               Sucursal[]
  usuarios                 Usuario[]
  clientes                 Cliente[]
  roles                    Rol[]
  motos                    Vehiculo[]
  categorias               CategoriaProducto[]
  productos                Producto[]
  lotes                    Lote[]
  ventas                   Venta[]
  pre_ventas               PreVenta[]
  servicios                Servicio[]
  citas                    Cita[]
  tipos_serv               TipoServicio[]
  opciones_serv            OpcionServicio[]
  checklist                ChecklistItem[]
  proveedores              Proveedor[]
  cajas                    Caja[]
  cuentas_bancarias        CuentaBancaria[]
  categorias_trans_neg     CategoriaTransaccion[]
  transacciones            Transaccion[]
  pais                     Pais?                     @relation(fields: [pais_id], references: [id])
  moneda                   Moneda?                   @relation(fields: [moneda_id], references: [id])
  negocioLimite            NegocioLimite?
  medias                   Media[]
  verificationCodes        VerificationCode[]
  cotizacions              Cotizacion[]
  facturas                 Factura[]
  negocioFacturacionConfig NegocioFacturacionConfig?

  @@map("negocios")
}

model NegocioFacturacionConfig {
  id         String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String @unique @db.Char(36)

  // Datos Fiscales del Contribuyente (SAT)
  nit_emisor       String @db.VarChar(20)
  nombre_emisor    String @db.VarChar(255)
  nombre_comercial String @db.VarChar(255)
  afiliacion_iva   String @default("GEN") @db.VarChar(10) // "GEN" (12%) o "PEQ" (5%)
  tipo_frase       Int    @default(1) // Frase SAT (ej. 1)
  codigo_escenario Int    @default(2) // Escenario SAT (ej. 2 - Sujeto a Pagos Trimestrales)
  correo_emisor    String @db.VarChar(150)

  // Credenciales API Digifact
  fel_username String @db.VarChar(100)
  fel_password String @db.Text
  fel_ambiente String @default("TEST") @db.VarChar(10) // "TEST" o "PRODUCCION"

  token_temporal  String?   @db.Text
  token_expira_at DateTime?

  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)

  @@map("negocio_facturacion_configs")
}

model Media {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String   @db.Char(36)
  path       String   @db.Text // Path único en R2: "productos/prod_abc123/img.webp"
  size_bytes Int // Tamaño exacto del archivo procesado en WebP
  mime_type  String   @db.VarChar(50) // e.g., "image/webp"
  created_at DateTime @default(now())

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)

  @@index([negocio_id])
  @@map("media")
}

model Sucursal {
  id                 String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id         String   @db.Char(36)
  division_nivel2_id String?  @db.Char(36) // Relación directa con el Municipio/Ciudad
  nombre             String
  direccion          String?
  telefono           String?
  email              String?
  activo             Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  codigo_establecimiento String  @default("1") @db.VarChar(10) // "1", "2", "3"...
  codigo_postal          String? @db.VarChar(10)

  negocio           Negocio                  @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  usuarios          Usuario[]
  ventas            Venta[]
  pre_ventas        PreVenta[]
  servicios         Servicio[]
  citas             Cita[]
  lotes             Lote[]
  cajas             Caja[]
  cuentas_bancarias SucursalCuentaBancaria[]
  transacciones     Transaccion[]
  trasladosOrigen   Traslado[]               @relation("SucursalOrigen")
  trasladosDestino  Traslado[]               @relation("SucursalDestino")
  cotizacions       Cotizacion[]
  facturas          Factura[]
  division_nivel_2  DivisionNivel2?          @relation(fields: [division_nivel2_id], references: [id], onDelete: SetNull)

  @@index([negocio_id])
  @@map("sucursales")
}

model Session {
  id               String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  token            String   @unique(map: "token") @db.VarChar(255)
  fcm_token        String?  @db.VarChar(255)
  usuario_id       String   @db.Char(36)
  fecha_expiracion DateTime
  fecha_creacion   DateTime @default(now())
  usuario          Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id])
  @@index([usuario_id])
  @@map("sessions")
}

// ==============================================================
// 2. IDENTIDAD Y ACCESO (IAM)
// ==============================================================

model Usuario {
  id            String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id    String   @db.Char(36)
  sucursal_id   String?  @db.Char(36)
  avatar_url    String?  @db.Text
  email         String?
  password_hash String?
  nombre        String
  apellido      String?
  dpi           String?
  nit           String?
  telefono      String
  pin_caja      String?  @db.Text
  pin_modelo    String?  @db.Text
  pin_sucursal  String?  @db.Text
  verificado    Boolean  @default(false)
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursal_id], references: [id], onDelete: SetNull)
  roles    Rol[]     @relation("UsuarioRoles")
  sessions Session?

  // Relaciones inversas corregidas
  servicios_mecanico      ServicioVehiculo[] @relation(name: "ServicioMecanico")
  ventas_vendedor         Venta[]            @relation(name: "VentaVendedor")
  trasladosCreados        Traslado[]         @relation(name: "TrasladosCreados")
  trasladosRecibidos      Traslado[]         @relation(name: "TrasladosRecibidos")
  servicios_recepcionista Servicio[]         @relation(name: "ServicioRecepcionista")
  ventas_autorizadas      Venta[]            @relation("VentaAutorizador")
  pre_ventas              PreVenta[]         @relation("PreVentaUsuario")
  transacciones_hechas    Transaccion[]      @relation("TransaccionesUsuario")
  cotizacions             Cotizacion[]
  corteCajas              CorteCaja[]
  facturas                Factura[]

  @@unique([negocio_id, email])
  @@unique([negocio_id, dpi])
  @@index([negocio_id])
  @@map("usuarios")
}

model Cliente {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String   @db.Char(36)
  nombre     String
  apellido   String?
  telefono   String
  email      String?
  nit        String?
  dpi        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio     Negocio      @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  motos       Vehiculo[]
  citas       Cita[]       @relation("CitaCliente")
  servicios   Servicio[]   @relation("ServicioCliente")
  ventas      Venta[]      @relation("VentaCliente")
  pre_ventas  PreVenta[]   @relation("PreVentaCliente")
  cotizacions Cotizacion[]
  facturas    Factura[]

  @@unique([negocio_id, telefono])
  @@unique([negocio_id, dpi])
  @@index([negocio_id])
  @@map("clientes")
}

model Rol {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id  String   @db.Char(36)
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  permisos Permiso[] @relation("RolPermisos")
  usuarios Usuario[] @relation("UsuarioRoles")

  @@unique([negocio_id, nombre])
  @@map("roles")
}

// ==============================================================
// 3. CATÁLOGOS MAESTROS (GLOBALES)
// ==============================================================

model Marca {
  id         String     @id @default(dbgenerated("(UUID())")) @db.Char(36)
  marca      String     @unique
  activo     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  modelos    Modelo[]
  Productos  Producto[]

  @@map("marcas")
}

model Linea {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  linea      String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  modelos    Modelo[]

  @@map("lineas")
}

model Cilindrada {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  cilindrada Int      @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  modelos    Modelo[]

  @@map("cilindradas")
}

model Modelo {
  id               String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  modelo           String   @unique
  anio             Int
  marca_id         String   @db.Char(36)
  linea_id         String   @db.Char(36)
  cilindrada_id    String   @db.Char(36)
  vehiculo_tipo_id String?  @db.Char(36)
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  marca         Marca         @relation(fields: [marca_id], references: [id])
  linea         Linea         @relation(fields: [linea_id], references: [id])
  cilindrada    Cilindrada    @relation(fields: [cilindrada_id], references: [id])
  vehiculo_tipo VehiculoTipo? @relation(fields: [vehiculo_tipo_id], references: [id])
  vehiculos     Vehiculo[]

  @@map("modelos")
}

// ==============================================================
// 4. OPERATIVA DE TALLER
// ==============================================================

model Vehiculo {
  id               String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id       String   @db.Char(36)
  placa            String
  modelo_id        String   @db.Char(36)
  avatar_url       String?  @db.Text
  calcomania_url   String?  @db.Text
  vehiculo_tipo_id String   @db.Char(36)
  cliente_id       String?  @db.Char(36)
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  negocio          Negocio            @relation(fields: [negocio_id], references: [id])
  modelo           Modelo             @relation(fields: [modelo_id], references: [id])
  cliente          Cliente?           @relation(fields: [cliente_id], references: [id])
  vehiculo_tipo    VehiculoTipo       @relation(fields: [vehiculo_tipo_id], references: [id])
  servicioVehiculo ServicioVehiculo[]
  citas            Cita[]
  cotizacions      Cotizacion[]

  @@unique([negocio_id, placa])
  @@map("vehiculos")
}

model VehiculoTipo {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  tipo       String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vehiculos Vehiculo[]
  modelos   Modelo[]

  @@map("vehiculo_tipos")
}

model Cita {
  id                String     @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id        String     @db.Char(36)
  sucursal_id       String     @db.Char(36)
  cliente_id        String?    @db.Char(36)
  vehiculo_id       String?    @db.Char(36)
  tipo_servicio_id  String     @db.Char(36)
  nombre_contacto   String
  telefono_contacto String
  placa             String?
  descripcion       String?    @db.Text
  fecha_cita        DateTime
  hora_cita         String
  estado            EstadoCita @default(PENDIENTE)
  activo            Boolean    @default(true)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  negocio       Negocio      @relation(fields: [negocio_id], references: [id])
  sucursal      Sucursal     @relation(fields: [sucursal_id], references: [id])
  cliente       Cliente?     @relation("CitaCliente", fields: [cliente_id], references: [id])
  vehiculo      Vehiculo?    @relation(fields: [vehiculo_id], references: [id])
  tipo_servicio TipoServicio @relation(fields: [tipo_servicio_id], references: [id])

  @@index([negocio_id])
  @@map("citas")
}

model Servicio {
  id                String       @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id        String       @db.Char(36)
  sucursal_id       String       @db.Char(36)
  cliente_id        String?      @db.Char(36)
  tipo_servicio_id  String?      @db.Char(36)
  recepcionista_id  String?      @db.Char(36)
  descripcion       String?      @db.Text
  diagnostico       String?      @db.Text
  observaciones     String?      @db.Text
  firma_entrada     String?      @db.Text
  firma_salida      String?      @db.Text
  fecha_entrada     DateTime     @default(now())
  fecha_salida      DateTime?
  subtotal          Float        @default(0)
  total             Float        @default(0)
  documento_extra   String?      @db.VarChar(20)
  nombre_extra      String?      @db.VarChar(255)
  numero_extra      String?      @db.VarChar(20)
  activo            Boolean      @default(true)
  efectivo_recibido Float?
  vuelto            Float?
  MetodoPago        MetodoPago?  @default(EFECTIVO)
  servicio_tipo     ServicioTipo @default(VEHICULO)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  negocio       Negocio       @relation(fields: [negocio_id], references: [id])
  sucursal      Sucursal      @relation(fields: [sucursal_id], references: [id])
  cliente       Cliente?      @relation(name: "ServicioCliente", fields: [cliente_id], references: [id])
  recepcionista Usuario?      @relation(name: "ServicioRecepcionista", fields: [recepcionista_id], references: [id])
  tipo_servicio TipoServicio? @relation(fields: [tipo_servicio_id], references: [id])

  servicioVehiculo         ServicioVehiculo?          @relation(name: "ServicioServicioVehiculo")
  imagenes                 Imagen[]
  checklist                ChecklistRespuesta[]
  tareas                   ServicioTarea[]
  repuestos                ServicioRepuesto[]
  ServicioRepuestoCliente  ServicioRepuestoCliente[]
  CambiosSiguienteServicio CambiosSiguienteServicio[]
  cotizacion               Cotizacion?
  servicioReparacion       ServicioReparacion[]
  servicioCustodia         ServicioCustodia[]
  facturas                 Factura[]

  @@map("servicios")
}

model ServicioReparacion {
  id            String    @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id   String    @db.Char(36)
  descripcion   String?   @db.Text
  firma_entrada String?   @db.Text
  firma_salida  String?   @db.Text
  fecha_entrada DateTime  @default(now())
  fecha_salida  DateTime?
  total         Float     @default(0)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  servicio                    Servicio                     @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  servicioRepuestos           ServicioRepuesto[]
  servicioReparacionRepuestos ServicioReparacionRepuesto[]
  facturaDetalles             FacturaDetalle[]

  @@map("reparacion_servicio")
}

model ServicioCustodia {
  id            String    @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id   String    @db.Char(36)
  descripcion   String?   @db.Text
  firma_salida  String?   @db.Text
  fecha_entrada DateTime  @default(now())
  fecha_salida  DateTime?
  total         Float     @default(0)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  servicio        Servicio         @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  facturaDetalles FacturaDetalle[]

  @@map("custodia_servicio")
}

model ServicioVehiculo {
  id                 String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id        String   @unique @db.Char(36)
  vehiculo_id        String   @db.Char(36)
  mecanico_id        String?  @db.Char(36)
  kilometraje        Int
  proximoKilometraje Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  estado   EstadoServicioVehiculo @default(RECEPCION)
  servicio Servicio               @relation(name: "ServicioServicioVehiculo", fields: [servicio_id], references: [id], onDelete: Cascade)
  vehiculo Vehiculo               @relation(fields: [vehiculo_id], references: [id], onDelete: Cascade)
  mecanico Usuario?               @relation(name: "ServicioMecanico", fields: [mecanico_id], references: [id], onDelete: Cascade)

