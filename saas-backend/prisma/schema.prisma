model Producto {
  id           String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id   String   @db.Char(36)
  sku          String?  @db.VarChar(100)
  correlativo  String?  @db.VarChar(20)
  categoria_id String   @db.Char(36)
  marca_id     String?  @db.Char(36)
  nombre       String   @db.VarChar(100)
  descripcion  String?  @db.Text
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  negocio           Negocio            @relation(fields: [negocio_id], references: [id])
  categoria         CategoriaProducto  @relation(fields: [categoria_id], references: [id])
  marca             Marca?             @relation(fields: [marca_id], references: [id])
  variantes         VarianteProducto[]
  productoAtributos ProductoAtributo[]

  imagenes ImagenProducto[]

  @@unique([negocio_id, sku])
  @@map("productos")
}

model ImagenProducto {
  id           String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  producto_id  String   @db.Char(36)
