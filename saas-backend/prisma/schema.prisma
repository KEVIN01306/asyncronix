// 7. FINANZAS Y VENTAS
// ==============================================================

model Venta {
  id                String      @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id        String      @db.Char(36)
  sucursal_id       String      @db.Char(36)
  usuario_id        String      @db.Char(36)
  cliente_id        String?     @db.Char(36)
  autorizador_id    String?     @db.Char(36)
  total             Float
  total_costo       Float
  comentarios       String?     @db.Text
  motivo_anulacion  String?     @db.Text
  efectivo_recibido Float?
  vuelto            Float?
  estado            EstadoVenta @default(PENDIENTE)
  activo            Boolean     @default(true)
  metodo_pago       MetodoPago  @default(EFECTIVO)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  negocio     Negocio        @relation(fields: [negocio_id], references: [id])
  sucursal    Sucursal       @relation(fields: [sucursal_id], references: [id])
  usuario     Usuario        @relation("VentaVendedor", fields: [usuario_id], references: [id])
  cliente     Cliente?       @relation("VentaCliente", fields: [cliente_id], references: [id])
  autorizador Usuario?       @relation("VentaAutorizador", fields: [autorizador_id], references: [id])
  detalles    VentaDetalle[]
  cotizacion  Cotizacion?
  facturas    Factura[]

  @@map("ventas")
}

model VentaDetalle {
  id              String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  venta_id        String   @db.Char(36)
  lote_id         String?  @db.Char(36)
  variante_id     String?  @db.Char(36)
  descripcion     String
  cantidad        Int
  precio_unitario Float
  costo_unitario  Float    @default(0)
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  venta    Venta             @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  lote     Lote?             @relation(fields: [lote_id], references: [id])
  variante VarianteProducto? @relation(fields: [variante_id], references: [id])

  @@index([variante_id])
  @@map("venta_detalles")
}

// ==============================================================
// TABLAS DE FACTURACIÓN (DTE / SAT / FEL)
// ==============================================================

model Factura {
  id          String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id  String  @db.Char(36)
  sucursal_id String  @db.Char(36)
  usuario_id  String  @db.Char(36) // Emisor o cajero
  cliente_id  String? @db.Char(36)

  // Enlaces opcionales al origen comercial/taller
  venta_id    String? @db.Char(36)
  servicio_id String? @db.Char(36)

  // Datos fiscales oficiales
  tipo_dte         TipoDTE @default(FACT)
  serie            String? @db.VarChar(50)
  numero_factura   String  @db.VarChar(50)
  dte_uuid         String? @unique @db.VarChar(100) // Número de autorización SAT
  dte_sat_xml      String? @db.LongText // XML firmado completo
  dle_sat_pdf      String? @db.LongText // PDF firmado completo
  dte_certificador String? @db.VarChar(100)
  acuse_recibo_sat String? @db.VarChar(255)

  // Datos del receptor en el momento de emisión
  receptor_nit       String  @default("CF") @db.VarChar(20)
  receptor_nombre    String  @db.VarChar(255)
  receptor_direccion String? @db.VarChar(255)

  // Desglose de importes
  subtotal_sin_iva Float // Base Imponible / Monto Gravable
  descuento        Float @default(0)
  iva              Float @default(0) // Monto Impuesto (12%)
  total            Float // Total general a cobrar

  metodo_pago         MetodoPago    @default(EFECTIVO)
  estado              EstadoFactura @default(EMITIDA)
  motivo_anulacion    String?       @db.Text
  acuse_anulacion     String?       @db.VarChar(255)
  fecha_emision       DateTime      @default(now())
  fecha_certificacion DateTime?
  fecha_anulacion     DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  negocio  Negocio   @relation(fields: [negocio_id], references: [id])
  sucursal Sucursal  @relation(fields: [sucursal_id], references: [id])
  usuario  Usuario   @relation(fields: [usuario_id], references: [id])
  cliente  Cliente?  @relation(fields: [cliente_id], references: [id])
  venta    Venta?    @relation(fields: [venta_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])

  detalles FacturaDetalle[]

  @@unique([negocio_id, serie, numero_factura])
  @@index([negocio_id])
  @@index([sucursal_id])
  @@index([dte_uuid])
  @@map("facturas")
}

model FacturaDetalle {
  id         String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  factura_id String @db.Char(36)

  // Referencias polimórficas opcionales a lo que se facturó
  variante_id            String? @db.Char(36) // Si fue un repuesto de inventario
  tipo_servicio_id       String? @db.Char(36) // Si fue paquete de servicio estándar
  servicio_reparacion_id String? @db.Char(36) // Si fue una reparación puntual
  servicio_custodia_id   String? @db.Char(36) // Si fue cobro por custodia

  tipo_item       TipoItemFactura @default(BIEN) // BIEN o SERVICIO para DTE
  descripcion     String          @db.VarChar(255)
  cantidad        Float           @default(1.0)
  unidad_medida   String          @default("UNI") @db.VarChar(10) // "UNI", "SER", etc.
  precio_unitario Float // Precio con IVA incluido
  descuento       Float           @default(0)
  monto_gravable  Float // Base sin IVA
  monto_impuesto  Float // IVA individual
  total           Float // Importe total de línea

  factura             Factura             @relation(fields: [factura_id], references: [id], onDelete: Cascade)
  variante            VarianteProducto?   @relation(fields: [variante_id], references: [id])
  tipo_servicio       TipoServicio?       @relation(fields: [tipo_servicio_id], references: [id])
  servicio_reparacion ServicioReparacion? @relation(fields: [servicio_reparacion_id], references: [id])
  servicio_custodia   ServicioCustodia?   @relation(fields: [servicio_custodia_id], references: [id])

  @@index([factura_id])
  @@map("factura_detalles")
}

model PreVenta {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id  String   @db.Char(36)
  sucursal_id String   @db.Char(36)
  usuario_id  String   @db.Char(36)
  cliente_id  String?  @db.Char(36)
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio    Negocio           @relation(fields: [negocio_id], references: [id])
  sucursal   Sucursal          @relation(fields: [sucursal_id], references: [id])
  usuario    Usuario           @relation("PreVentaUsuario", fields: [usuario_id], references: [id])
  cliente    Cliente?          @relation("PreVentaCliente", fields: [cliente_id], references: [id])
  detalles   PreVentaDetalle[]
  cotizacion Cotizacion?

  @@map("pre_ventas")
}

model PreVentaDetalle {
  id           String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  pre_venta_id String @db.Char(36)
  variante_id  String @db.Char(36)
  descripcion  String
  cantidad     Int
  precio       Float

  pre_venta PreVenta         @relation(fields: [pre_venta_id], references: [id], onDelete: Cascade)
  variante  VarianteProducto @relation(fields: [variante_id], references: [id])

  @@map("pre_venta_detalles")
}

model Cotizacion {
  id          String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id  String  @db.Char(36)
  sucursal_id String  @db.Char(36)
  usuario_id  String  @db.Char(36) // Recepcionista o vendedor
  cliente_id  String? @db.Char(36) // Opcional, por si cotizan al público en general
  vehiculo_id String? @db.Char(36) // Opcional, si va destinado al taller

  correlativo   Int                   @default(1)
  codigo        String
  total         Float
  fecha_emision DateTime              @default(now())
  fecha_validez DateTime // Fecha de expiración de precios
  estado        EstadoCotizacion      @default(PENDIENTE)
  tipo_destino  TipoDestinoCotizacion @default(VENTA_DIRECTA)
  terminos      String?               @db.Text

  // Enlaces cuando se convierte a una operación real
  venta_id    String? @unique @db.Char(36)
  preventa_id String? @unique @db.Char(36)
  servicio_id String? @unique @db.Char(36)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocio_id], references: [id])
  sucursal Sucursal  @relation(fields: [sucursal_id], references: [id])
  usuario  Usuario   @relation(fields: [usuario_id], references: [id])
  cliente  Cliente?  @relation(fields: [cliente_id], references: [id])
  vehiculo Vehiculo? @relation(fields: [vehiculo_id], references: [id])
  venta    Venta?    @relation(fields: [venta_id], references: [id])
  preventa PreVenta? @relation(fields: [preventa_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])

  detalles CotizacionDetalle[]

  @@index([negocio_id])
  @@index([sucursal_id])
  @@index([estado])
  @@map("cotizaciones")
}

model CotizacionDetalle {
  id            String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  cotizacion_id String @db.Char(36)

  variante_id      String? @db.Char(36) // Si cotiza un repuesto
  tipo_servicio_id String? @db.Char(36) // Si cotiza paquete de servicio
  // Nota: Ambos pueden ir nulos si es "mano de obra a medida" o un ítem fuera de inventario

  descripcion     String @db.VarChar(255)
  cantidad        Int
  precio_unitario Float
  descuento       Float  @default(0)
  subtotal        Float // Guardar el subtotal mejora el rendimiento al consultar

  cotizacion    Cotizacion        @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  variante      VarianteProducto? @relation(fields: [variante_id], references: [id])
  tipo_servicio TipoServicio?     @relation(fields: [tipo_servicio_id], references: [id])

  @@index([cotizacion_id])
  @@map("cotizacion_detalles")
}

model Imagen {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id String   @db.Char(36)
  imagen      String   @db.Text
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)

  @@map("imagenes")
}

model Banco {
  id               String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  nombre_comercial String   @unique
  razon_social     String   @unique
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  cuentas CuentaBancaria[]

  @@map("bancos")
}

model Caja {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id  String   @db.Char(36)
  sucursal_id String   @db.Char(36)
  nombre      String // Ej: "Caja Principal", "Caja Virtual Efectivo"
  tipo        TipoCaja @default(FISICA)
  saldo       Float    @default(0)

  ip_autorizada    String?  @db.VarChar(45)
  asociacion_id    String?  @db.Char(36) // Para cajas virtuales asociadas a un usuario o a un negocio externo
  token_autorizado String?  @db.VarChar(255)
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  negocio  Negocio  @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)

  // Relaciones para auditoría de movimientos
  transaccionesOrigen  Transaccion[] @relation("OrigenCaja")
  transaccionesDestino Transaccion[] @relation("DestinoCaja")
  corteCajas           CorteCaja[]

  @@map("cajas")
}

model CuentaBancaria {
  id                String             @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id        String             @db.Char(36)
  banco_id          String             @db.Char(36)
  moneda_id         String?            @db.Char(36)
  numero_cuenta     String
  nombre_titular    String
  tipo              TipoCuentaBancaria @default(MONETARIA)
  saldo             Float              @default(0)
  saldo_moneda_base Float?             @default(0)
  activo            Boolean            @default(true)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  banco   Banco   @relation(fields: [banco_id], references: [id])

  // Relación Muchos a Muchos implícita o explícita con sucursales
  sucursales SucursalCuentaBancaria[]

  transaccionesOrigen  Transaccion[] @relation("OrigenCuenta")
  transaccionesDestino Transaccion[] @relation("DestinoCuenta")
  moneda               Moneda?       @relation(fields: [moneda_id], references: [id])

  @@unique([negocio_id, numero_cuenta])
  @@map("cuentas_bancarias")
}

// Tabla intermedia explícita para poder asignar una cuenta a varias sucursales
model SucursalCuentaBancaria {
  sucursal_id        String     @db.Char(36)
  cuenta_bancaria_id String     @db.Char(36)
  metodo_pago        MetodoPago
  created_at         DateTime   @default(now())

  sucursal        Sucursal       @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)
  cuenta_bancaria CuentaBancaria @relation(fields: [cuenta_bancaria_id], references: [id], onDelete: Cascade)

  @@id([sucursal_id, cuenta_bancaria_id, metodo_pago])
  @@map("sucursal_cuentas_bancarias")
}

model CategoriaTransaccion {
  id         String         @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String?        @db.Char(36) // null si es una categoría global del sistema
  nombre     String // Ej: "Pago de Planilla", "Compra de Suministros", "Venta de Repuestos"
  tipo       TipoMovimiento
  activo     Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  negocio       Negocio?      @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  transacciones Transaccion[]

  @@unique([negocio_id, nombre])
  @@map("categorias_transaccion")
}

model Transaccion {
  id           String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id   String  @db.Char(36)
  sucursal_id  String  @db.Char(36)
  categoria_id String? @db.Char(36)
  usuario_id   String  @db.Char(36)

  correlativo Int    @default(1)
  codigo      String

  tipo_movimiento TipoMovimiento
  origen_tipo     TipoOrigenTransaccion @default(INGRESO_EGRESO)

  moneda_actual_id  String? @db.Char(36)
  moneda_id         String  @db.Char(36)
  monto_original    Float
  tipo_cambio       Float   @default(1.0)
  monto_moneda_base Float

  metodo_pago MetodoPago?

  descripcion String? @db.Text

  origen_entidad    TipoEntidadFinanciera?
  origen_caja_id    String?                @db.Char(36)
  origen_cuenta_id  String?                @db.Char(36)
  destino_entidad   TipoEntidadFinanciera?
  destino_caja_id   String?                @db.Char(36)
  destino_cuenta_id String?                @db.Char(36)

  fecha_transaccion DateTime @default(now())
  created_at        DateTime @default(now())

  corte_caja_id String? @db.Char(36)

  negocio       Negocio               @relation(fields: [negocio_id], references: [id])
  sucursal      Sucursal              @relation(fields: [sucursal_id], references: [id])
  categoria     CategoriaTransaccion? @relation(fields: [categoria_id], references: [id])
  usuario       Usuario               @relation("TransaccionesUsuario", fields: [usuario_id], references: [id])
  moneda        Moneda                @relation(fields: [moneda_id], references: [id])
  moneda_actual Moneda?               @relation("MonedaActual", fields: [moneda_actual_id], references: [id])

  origen_caja    Caja?           @relation("OrigenCaja", fields: [origen_caja_id], references: [id])
  origen_cuenta  CuentaBancaria? @relation("OrigenCuenta", fields: [origen_cuenta_id], references: [id])
  destino_caja   Caja?           @relation("DestinoCaja", fields: [destino_caja_id], references: [id])
  destino_cuenta CuentaBancaria? @relation("DestinoCuenta", fields: [destino_cuenta_id], references: [id])
  corte_caja     CorteCaja?      @relation(fields: [corte_caja_id], references: [id])

  @@map("transacciones")
}

model CorteCaja {
  id         String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  caja_id    String @db.Char(36)
  usuario_id String @db.Char(36) // Quién abre/cierra la caja

  fecha_apertura DateTime  @default(now())
  fecha_cierre   DateTime?

  saldo_inicial   Float // Con cuánto empezó el turno
  ventas_efectivo Float @default(0) // Suma de ingresos en efectivo
  otros_ingresos  Float @default(0)
  egresos         Float @default(0)

  saldo_esperado Float? // Calculado por el sistema: (inicial + ingresos - egresos)
  saldo_real     Float? // Lo que el cajero cuenta físicamente
  diferencia     Float? // Positivo (sobrante), Negativo (faltante)

  estado        EstadoCorte @default(ABIERTO)
  observaciones String?     @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  caja          Caja          @relation(fields: [caja_id], references: [id])
  usuario       Usuario       @relation(fields: [usuario_id], references: [id])
  transacciones Transaccion[] // Relación con los movimientos del turno

  @@map("cortes_caja")
}

model VerificationCode {
  id         String           @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String           @db.Char(36)
  email      String           @db.VarChar(255)
  code       String           @db.VarChar(6)
  tipo       TipoVerificacion
  expira_at  DateTime
  usado      Boolean          @default(false)
  created_at DateTime         @default(now())

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)

  @@index([email, code])
  @@index([negocio_id])
  @@map("verification_codes")
}

// ==============================================================
// 8. ENUMERACIONES
// ==============================================================

enum TipoDTE {
  FACT // Factura
  FCAM // Factura cambiaria
  FPEQ // Factura pequeño contribuyente
  NCRE // Nota de crédito
  NDEB // Nota de débito
}

enum TipoItemFactura {
  BIEN // Bienes tangibles (repuestos, lubricantes, etc.)
  SERVICIO // Servicios intangibles (mano de obra, reparaciones, custodias)
}

enum EstadoFactura {
  EMITIDA // Creada internamente en el sistema
  CERTIFICADA // Autorizada por SAT (con UUID y XML oficial)
  ANULADA // Dejada sin efecto ante SAT
  ERROR // Fallo de validación
}

enum ProcedenciaRepuesto {
  PROPIO
  CLIENTE
}

enum EstadoCorte {
  ABIERTO
  CERRADO
}

enum EstadoCotizacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum TipoDestinoCotizacion {
  VENTA_DIRECTA // Para facturar directo en mostrador
  TALLER // Para ingresar un vehículo a servicio
}

enum TipoVerificacion {
  REGISTRO_USUARIO
  RECUPERACION_PASSWORD
  CAMBIO_EMAIL
}

enum TipoCaja {
  FISICA
  EN_LINEA
}

enum TipoEntidadFinanciera {
  CAJA
  CUENTA
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  TRANSFERENCIA
}

enum TipoOrigenTransaccion {
  VENTA
  SERVICIO
  INGRESO_EGRESO
  MOVIMIENTO_INTERNO
}

enum TipoCuentaBancaria {
  MONETARIA
  AHORRO
  PLANILLA
  CORRIENTE
  PLAZO_FIJO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  EN_TALLER
  CANCELADA
  NO_ASISTIO
}

enum EstadoServicioVehiculo {
  RECEPCION
  EN_SERVICIO
  EN_PRUEBAS
  EN_DIAGNOSTICO
  ESPERA_REPUESTOS
  EN_REPARACION
  EN_CUSTODIA
  LISTO_ENTREGA
  FINALIZADO
  CANCELADO
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

enum EstadoChecklist {
  OPTIMO
  REGULAR
  REQUIERE_CAMBIO
  NO_APLICA
}

enum EstadoTraslado {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum ServicioTipo {
  VEHICULO
}
