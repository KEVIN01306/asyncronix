  descripcion  String?  @db.VarChar(255)
  es_principal Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  producto Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  variantes VarianteProducto[]

  @@index([producto_id])
  @@map("imagenes_producto")
}

model Atributo {
  id         String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id String   @db.Char(36)
  nombre     String // Ej. "Viscosidad", "Talla", "Medida"
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  valores           ValorAtributo[]
  productoAtributos ProductoAtributo[]

  @@unique([negocio_id, nombre])
  @@map("atributos")
}

model ProductoAtributo {
  producto_id String   @db.Char(36)
