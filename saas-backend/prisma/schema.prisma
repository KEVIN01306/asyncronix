  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  producto Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  atributo Atributo @relation(fields: [atributo_id], references: [id], onDelete: Cascade)

  @@id([producto_id, atributo_id])
  @@map("producto_atributos")
}

model VarianteProducto {
  id              String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  producto_id     String   @db.Char(36)
  imagen_id       String?  @db.Char(36)
  sku             String   @db.VarChar(100)
  correlativo     String?  @unique @db.VarChar(20)
  codigo_barras   String?  @unique
  qr_codigo       String?  @unique
  precio_sugerido Float
  stock_total     Int      @default(0)
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  producto           Producto            @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  imagen             ImagenProducto?     @relation(fields: [imagen_id], references: [id], onDelete: SetNull)
  valores            ValorAtributo[]
  lotes              Lote[]
  repuestos          ServicioRepuesto[]
  venta_detalles     VentaDetalle[]
  pre_venta_detalles PreVentaDetalle[]
  cotizacionDetalles CotizacionDetalle[]
  facturaDetalles    FacturaDetalle[]

  @@unique([producto_id, sku])
  @@index([producto_id])
  @@map("variantes_producto")
}

model ValorAtributo {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  atributo_id String   @db.Char(36)
  valor       String // Ej. "10W-40", "M", "120/70-17"
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  atributo  Atributo           @relation(fields: [atributo_id], references: [id], onDelete: Cascade)
  variantes VarianteProducto[] // Relación Many-to-Many implícita con variantes

  @@unique([atributo_id, valor])
  @@map("valores_atributos")
}

model Lote {
  id                String    @id @default(dbgenerated("(UUID())")) @db.Char(36)
  variante_id       String    @db.Char(36) // Cambiado de producto_id a variante_id
  negocio_id        String    @db.Char(36)
  sucursal_id       String    @db.Char(36)
  proveedor_id      String    @db.Char(36) // ¡Obligatorio para la trazabilidad!
  codigo_lote       String? // El código asignado a esta tanda de ingreso
  cantidad_inicial  Int // Para auditorías
  cantidad_actual   Int
  costo_compra      Float
  precio_venta      Float // Permite cambiar el precio real por lote si suben los costos
  fecha_ingreso     DateTime  @default(now())
  fecha_vencimiento DateTime? // Opcional (útil para químicos o aditivos)
  activo            Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  variante  VarianteProducto @relation(fields: [variante_id], references: [id], onDelete: Cascade)
  negocio   Negocio          @relation(fields: [negocio_id], references: [id])
  sucursal  Sucursal         @relation(fields: [sucursal_id], references: [id])
  proveedor Proveedor        @relation(fields: [proveedor_id], references: [id])

  repuestos        ServicioRepuesto[]
  detalles         VentaDetalle[]
  detallesTraslado DetalleTraslado[]

  @@index([variante_id])
  @@index([proveedor_id])
  @@map("lotes")
}

model ServicioRepuesto {
  id                     String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id            String?  @db.Char(36)
  servicio_reparacion_id String?  @db.Char(36)
  lote_id                String?  @db.Char(36)
  variante_id            String   @db.Char(36)
  cantidad               Int
  precio_venta           Float
  costo                  Float?
  activo                 Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  servicio            Servicio?           @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  servicio_reparacion ServicioReparacion? @relation(fields: [servicio_reparacion_id], references: [id], onDelete: Cascade)
  lote                Lote?               @relation(fields: [lote_id], references: [id])
  variante            VarianteProducto    @relation(fields: [variante_id], references: [id])

  @@index([variante_id])
  @@map("servicio_repuestos")
}

model ServicioReparacionRepuesto {
  id                     String              @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_reparacion_id String              @db.Char(36)
  descripccion           String              @db.Text
  cantidad               Int
  instrucciones          String              @db.Text
  entregado              Boolean             @default(false)
  procedencia            ProcedenciaRepuesto @default(CLIENTE)
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  servicio_reparacion ServicioReparacion @relation(fields: [servicio_reparacion_id], references: [id], onDelete: Cascade)
}

model CambiosSiguienteServicio {
  id          String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  servicio_id String   @db.Char(36)
  item        String   @db.VarChar(100)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)

  @@map("cambios_siguiente_servicio")
}

model Traslado {
  id             String         @id @default(dbgenerated("(UUID())")) @db.Char(36)
  consecutivo    Int            @unique @default(autoincrement())
  origen_id      String         @db.Char(36)
  destino_id     String         @db.Char(36)
  creador_id     String         @db.Char(36)
  recibidor_id   String?        @db.Char(36)
  estado         EstadoTraslado @default(PENDIENTE) // PENDIENTE, COMPLETADO, CANCELADO
  fecha_recibido DateTime?
  comentarios    String?        @db.Text
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  creador   Usuario           @relation("TrasladosCreados", fields: [creador_id], references: [id])
  recibidor Usuario?          @relation("TrasladosRecibidos", fields: [recibidor_id], references: [id])
  origen    Sucursal          @relation("SucursalOrigen", fields: [origen_id], references: [id])
  destino   Sucursal          @relation("SucursalDestino", fields: [destino_id], references: [id])
  detalles  DetalleTraslado[]
}

model DetalleTraslado {
  id          String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  traslado_id String @db.Char(36)
  lote_id     String @db.Char(36) // Lote de ORIGEN
  cantidad    Int // Cantidad que se va a mover

  traslado Traslado @relation(fields: [traslado_id], references: [id], onDelete: Cascade)
  lote     Lote     @relation(fields: [lote_id], references: [id])
}

