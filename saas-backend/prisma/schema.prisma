  lotes   Lote[]

  @@unique([negocio_id, nombre])
  @@index([negocio_id])
  @@map("proveedores")
}

model CategoriaProducto {
  id                 String   @id @default(dbgenerated("(UUID())")) @db.Char(36)
  negocio_id         String?  @db.Char(36)
  categoria          String
  default_categoria  Boolean  @default(false)
  activo             Boolean  @default(true)
  categoria_padre_id String?  @db.Char(36)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  categoria_padre CategoriaProducto?  @relation("CategoriaHijos", fields: [categoria_padre_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subcategorias   CategoriaProducto[] @relation("CategoriaHijos")
  negocio         Negocio?            @relation(fields: [negocio_id], references: [id])
  productos       Producto[]

  @@unique([negocio_id, categoria])
  @@map("categorias_producto")
