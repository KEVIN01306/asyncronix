generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// 1. NÚCLEO SAAS, MÓDULOS Y AUTENTICACIÓN
// ==============================================================

model Modulo {
  id          String   @id @default(uuid()) @db.Char(36)
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  permisos Permiso[]
  negocios Negocio[]

  @@map("modulos")
}

model Permiso {
  id          String   @id @default(uuid()) @db.Char(36)
  modulo_id   String   @db.Char(36)
  codigo      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  modulo   Modulo    @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  roles    Rol[]     @relation("RolPermisos")
  negocios Negocio[] @relation("NegocioPermisos")

  @@map("permisos")
}

model Negocio {
  id                     String    @id @default(uuid()) @db.Char(36)
  nombre                 String
  slug                   String    @unique
  nombre_comercial       String    @db.VarChar(100)
  wa_id                  String    @unique(map: "wa_id") @db.VarChar(20)
  nit_rut                String?   @db.VarChar(20)
  logo_url               String?   @db.Text
  slogan                 String?   @db.VarChar(255)
  datos_facturacion_json Json?
  primary_color            String?   @db.VarChar(7)
  secondary_color          String?   @db.VarChar(7)
  instagram_id           String?   @db.VarChar(100)
  facebook_id            String?   @db.VarChar(100)
  activo                 Boolean   @default(true)
  fecha_registro         DateTime? @default(now()) @db.Timestamp(0)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  modulos      Modulo[]
  permisos     Permiso[]           @relation("NegocioPermisos")
  sucursales   Sucursal[]
  usuarios     Usuario[]
  clientes     Cliente[]
  roles        Rol[]
  motos        Vehiculo[]
  categorias   CategoriaProducto[]
  productos    Producto[]
  lotes        Lote[]
  ventas       Venta[]
  servicios    Servicio[]
  citas        Cita[]
  tipos_serv   TipoServicio[]
  opciones_serv OpcionServicio[]
  checklist    ChecklistItem[]
  contabilidad IngresosEgresos[]

  @@map("negocios")
}

model Sucursal {
  id         String   @id @default(uuid()) @db.Char(36)
  negocio_id String   @db.Char(36)
  nombre     String
  direccion  String?
  telefono   String?
  email      String?
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio          Negocio           @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  usuarios         Usuario[]
  ventas           Venta[]
  servicios        Servicio[]
  citas            Cita[]
  ingresos_egresos IngresosEgresos[]
  lotes            Lote[]

  @@index([negocio_id])
  @@map("sucursales")
}

model Session {
  id            String   @id @default(uuid()) @db.Char(36)
  token         String   @unique(map: "token") @db.VarChar(255)
  usuario_id    String   @db.Char(36) 
  fecha_expiracion       DateTime
  fecha_creacion DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@unique([usuario_id])
  @@map("sessions")
}
// ==============================================================
// 2. IDENTIDAD Y ACCESO (IAM)
// ==============================================================

model Usuario {
  id            String   @id @default(uuid()) @db.Char(36)
  negocio_id    String   @db.Char(36)
  sucursal_id   String?  @db.Char(36)
  avatar_url    String?  @db.Text
  email         String?
  password_hash String?
  nombre        String
  apellido      String?
  dpi           String?
  nit           String?
  telefono      String
  verificado    Boolean  @default(false)
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  negocio    Negocio    @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursal_id], references: [id], onDelete: SetNull)
  roles      Rol[]      @relation("UsuarioRoles")
  sessions   Session? 

  // Relaciones inversas corregidas
  servicios_mecanico Servicio[] @relation("ServicioMecanico")
  ventas_vendedor    Venta[]    @relation("VentaVendedor")

  @@unique([negocio_id, email])
  @@unique([negocio_id, dpi])
  @@index([negocio_id])
  @@map("usuarios")
}

model Cliente {
  id         String   @id @default(uuid()) @db.Char(36)
  negocio_id String   @db.Char(36)
  nombre     String
  apellido   String?
  telefono   String
  email      String?
  nit        String?
  dpi        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio   Negocio    @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  motos     Vehiculo[]
  citas     Cita[]     @relation("CitaCliente")
  servicios Servicio[] @relation("ServicioCliente")
  ventas    Venta[]    @relation("VentaCliente")

  @@unique([negocio_id, telefono])
  @@unique([negocio_id, dpi])
  @@index([negocio_id])
  @@map("clientes")
}

model Rol {
  id          String   @id @default(uuid()) @db.Char(36)
  negocio_id  String   @db.Char(36)
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  permisos Permiso[] @relation("RolPermisos")
  usuarios Usuario[] @relation("UsuarioRoles")

  @@unique([negocio_id, nombre])
  @@map("roles")
}

// ==============================================================
// 3. CATÁLOGOS MAESTROS (GLOBALES)
// ==============================================================

model Marca {
  id         String   @id @default(uuid()) @db.Char(36)
  marca      String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  modelos    Modelo[]

  @@map("marcas")
}

model Linea {
  id         String   @id @default(uuid()) @db.Char(36)
  linea      String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  modelos    Modelo[]

  @@map("lineas")
}

model Cilindrada {
  id         String   @id @default(uuid()) @db.Char(36)
  cilindrada Int      @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  modelos    Modelo[]

  @@map("cilindradas")
}

model Modelo {
  id            String   @id @default(uuid()) @db.Char(36)
  modelo        String   @unique
  anio          Int
  marca_id      String   @db.Char(36)
  linea_id      String   @db.Char(36)
  cilindrada_id String   @db.Char(36)
  vehiculo_tipo_id String?   @db.Char(36)
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  marca      Marca      @relation(fields: [marca_id], references: [id])
  linea      Linea      @relation(fields: [linea_id], references: [id])
  cilindrada Cilindrada @relation(fields: [cilindrada_id], references: [id])
  vehiculo_tipo VehiculoTipo? @relation(fields: [vehiculo_tipo_id], references: [id])
  vehiculos  Vehiculo[]

  @@map("modelos")
}

// ==============================================================
// 4. OPERATIVA DE TALLER
// ==============================================================

model Vehiculo {
  id         String   @id @default(uuid()) @db.Char(36)
  negocio_id String   @db.Char(36)
  placa      String
  modelo_id  String   @db.Char(36)
  avatar_url String?
  calcomania_url String?
  vehiculo_tipo_id String   @db.Char(36)
  cliente_id String?  @db.Char(36)
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio   Negocio    @relation(fields: [negocio_id], references: [id])
  modelo    Modelo     @relation(fields: [modelo_id], references: [id])
  cliente   Cliente?   @relation(fields: [cliente_id], references: [id])
  vehiculo_tipo VehiculoTipo @relation(fields: [vehiculo_tipo_id], references: [id])
  servicios Servicio[]
  citas     Cita[]

  @@unique([negocio_id, placa])
  @@map("vehiculos")
}

model VehiculoTipo {
  id         String   @id @default(uuid()) @db.Char(36)
  tipo       String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vehiculos Vehiculo[]
  modelos Modelo[]

  @@map("vehiculo_tipos")
}

model Cita {
  id                String     @id @default(uuid()) @db.Char(36)
  negocio_id        String     @db.Char(36)
  sucursal_id       String     @db.Char(36)
  cliente_id        String?    @db.Char(36)
  vehiculo_id       String?    @db.Char(36)
  tipo_servicio_id  String     @db.Char(36)
  nombre_contacto   String
  telefono_contacto String
  placa             String?
  descripcion       String?    @db.Text
  fecha_cita        DateTime
  hora_cita         String
  estado            EstadoCita @default(PENDIENTE)
  activo            Boolean    @default(true)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  negocio       Negocio      @relation(fields: [negocio_id], references: [id])
  sucursal      Sucursal     @relation(fields: [sucursal_id], references: [id])
  cliente       Cliente?     @relation("CitaCliente", fields: [cliente_id], references: [id])
  vehiculo      Vehiculo?    @relation(fields: [vehiculo_id], references: [id])
  tipo_servicio TipoServicio @relation(fields: [tipo_servicio_id], references: [id])

  @@index([negocio_id])
  @@map("citas")
}

model Servicio {
  id               String         @id @default(uuid()) @db.Char(36)
  negocio_id       String         @db.Char(36)
  sucursal_id      String         @db.Char(36)
  vehiculo_id      String         @db.Char(36)
  mecanico_id      String?         @db.Char(36)
  cliente_id       String?        @db.Char(36)
  tipo_servicio_id String?         @db.Char(36)
  descripcion      String?         @db.Text
  diagnostico      String?        @db.Text
  kilometraje      Int?
  fecha_entrada    DateTime       @default(now())
  fecha_salida     DateTime?
  total            Float          @default(0)
  estado           EstadoServicio @default(RECEPCION)
  activo           Boolean        @default(true)
  MetodoPago       MetodoPago     @default(EFECTIVO)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  negocio       Negocio      @relation(fields: [negocio_id], references: [id])
  sucursal      Sucursal     @relation(fields: [sucursal_id], references: [id])
  vehiculo      Vehiculo?    @relation(fields: [vehiculo_id], references: [id])
  mecanico      Usuario?      @relation("ServicioMecanico", fields: [mecanico_id], references: [id])
  cliente       Cliente?     @relation("ServicioCliente", fields: [cliente_id], references: [id])
  tipo_servicio TipoServicio? @relation(fields: [tipo_servicio_id], references: [id])
  
  imagenes  Imagen[]
  checklist ChecklistRespuesta[]
  tareas    ServicioTarea[]
  repuestos ServicioRepuesto[]
  venta     Venta?

  @@map("servicios")
}

model TipoServicio {
  id          String   @id @default(uuid()) @db.Char(36)
  negocio_id  String   @db.Char(36)
  nombre      String
  precio_base Float    @default(0)
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio   Negocio              @relation(fields: [negocio_id], references: [id])
  opciones  TipoServicioOpcion[]
  servicios Servicio[]
  citas     Cita[]

  @@map("tipos_servicio")
}

model OpcionServicio {
  id          String   @id @default(uuid()) @db.Char(36)
  negocio_id  String   @db.Char(36)
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio Negocio              @relation(fields: [negocio_id], references: [id])
  tipos   TipoServicioOpcion[]

  @@map("opciones_servicio")
}

model TipoServicioOpcion {
  tipo_servicio_id   String   @db.Char(36)
  opcion_servicio_id String   @db.Char(36)
  orden              Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tipo_servicio   TipoServicio   @relation(fields: [tipo_servicio_id], references: [id], onDelete: Cascade)
  opcion_servicio OpcionServicio @relation(fields: [opcion_servicio_id], references: [id], onDelete: Cascade)

  @@id([tipo_servicio_id, opcion_servicio_id])
  @@map("tipo_servicio_opciones")
}

// ==============================================================
// 5. COMPONENTES DE SERVICIO
// ==============================================

model ChecklistItem {
  id         String   @id @default(uuid()) @db.Char(36)
  negocio_id String   @db.Char(36)
  nombre     String
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio    Negocio              @relation(fields: [negocio_id], references: [id])
  respuestas ChecklistRespuesta[]
  @@map("checklist_items")
}

model ChecklistRespuesta {
  id                String          @id @default(uuid()) @db.Char(36)
  checklist_item_id String          @db.Char(36)
  servicio_id       String          @db.Char(36)
  estado            EstadoChecklist @default(OPTIMO)
  observaciones     String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  servicio       Servicio      @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  checklist_item ChecklistItem @relation(fields: [checklist_item_id], references: [id], onDelete: Cascade)
  @@unique([servicio_id, checklist_item_id])
  @@map("checklist_respuestas")
}

model ServicioTarea {
  id          String   @id @default(uuid()) @db.Char(36)
  servicio_id String   @db.Char(36)
  nombre      String
  completado  Boolean  @default(false)
  observacion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)

  @@map("servicio_tareas")
}

// ==============================================================
// 6. INVENTARIO (LOTES)
// ==============================================================

model CategoriaProducto {
  id         String   @id @default(uuid()) @db.Char(36)
  negocio_id String?   @db.Char(36)
  categoria  String
  default_categoria   Boolean  @default(false)
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  negocio   Negocio?    @relation(fields: [negocio_id], references: [id])
  productos Producto[]

  @@unique([negocio_id, categoria])
  @@map("categorias_producto")
}

model Producto {
  id              String   @id @default(uuid()) @db.Char(36)
  negocio_id      String   @db.Char(36)
  categoria_id    String   @db.Char(36)
  url_imagen      String   @db.Text
  qr_imagen       String?   @db.Text
  nombre          String
  codigo          String?
  sku             String?  
  precio_sugerido Float
  stock_total     Int      @default(0)
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  negocio   Negocio           @relation(fields: [negocio_id], references: [id])
  categoria CategoriaProducto @relation(fields: [categoria_id], references: [id])
  lotes     Lote[]

  @@unique([negocio_id, codigo])
  @@unique([sku])
  @@map("productos")
}

model Lote {
  id              String   @id @default(uuid()) @db.Char(36)
  producto_id     String   @db.Char(36)
  negocio_id      String   @db.Char(36)
  sucursal_id     String   @db.Char(36)
  cantidad_actual Int
  costo_compra    Float
  precio_venta    Float
  fecha_ingreso   DateTime @default(now())
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  producto  Producto           @relation(fields: [producto_id], references: [id])
  negocio   Negocio            @relation(fields: [negocio_id], references: [id])
  sucursal  Sucursal           @relation(fields: [sucursal_id], references: [id])
  repuestos ServicioRepuesto[]
  detalles  VentaDetalle[]

  @@map("lotes")
}

model ServicioRepuesto {
  id           String   @id @default(uuid()) @db.Char(36)
  servicio_id  String   @db.Char(36)
  lote_id      String   @db.Char(36)
  cantidad     Int
  precio_venta Float
  costo        Float
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  lote     Lote     @relation(fields: [lote_id], references: [id])

  @@map("servicio_repuestos")
}

// ==============================================================
// 7. FINANZAS Y VENTAS
// ==============================================================

model Venta {
  id          String      @id @default(uuid()) @db.Char(36)
  negocio_id  String      @db.Char(36)
  sucursal_id String      @db.Char(36)
  usuario_id  String      @db.Char(36)
  cliente_id  String?     @db.Char(36)
  servicio_id String?     @unique @db.Char(36)
  total       Float
  total_costo Float
  comentarios String?     @db.Text
  estado      EstadoVenta @default(PENDIENTE)
  activo      Boolean     @default(true)
  metodo_pago MetodoPago  @default(EFECTIVO)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  negocio  Negocio        @relation(fields: [negocio_id], references: [id])
  sucursal Sucursal       @relation(fields: [sucursal_id], references: [id])
  usuario  Usuario        @relation("VentaVendedor", fields: [usuario_id], references: [id])
  cliente  Cliente?       @relation("VentaCliente", fields: [cliente_id], references: [id])
  servicio Servicio?      @relation(fields: [servicio_id], references: [id])
  detalles VentaDetalle[]

  @@map("ventas")
}

model VentaDetalle {
  id              String   @id @default(uuid()) @db.Char(36)
  venta_id        String   @db.Char(36)
  lote_id         String?  @db.Char(36)
  descripcion     String
  cantidad        Int
  precio_unitario Float
  costo_unitario  Float    @default(0)
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  venta Venta @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  lote  Lote? @relation(fields: [lote_id], references: [id])

  @@map("venta_detalles")
}

model Imagen {
  id          String   @id @default(uuid()) @db.Char(36)
  servicio_id String   @db.Char(36)
  imagen      String
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)

  @@map("imagenes")
}

model TipoContabilidad {
  id               String            @id @default(uuid()) @db.Char(36)
  tipo             String
  activo           Boolean           @default(true)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  ingresos_egresos IngresosEgresos[]

  @@map("tipos_contabilidad")
}

model IngresosEgresos {
  id          String   @id @default(uuid()) @db.Char(36)
  negocio_id  String   @db.Char(36)
  sucursal_id String   @db.Char(36)
  tipo_id     String   @db.Char(36)
  descripcion String?
  monto       Float
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  negocio  Negocio          @relation(fields: [negocio_id], references: [id])
  sucursal Sucursal         @relation(fields: [sucursal_id], references: [id])
  tipo     TipoContabilidad @relation(fields: [tipo_id], references: [id])

  @@map("ingresos_egresos")
}

// ==============================================================
// 8. ENUMERACIONES
// ==============================================================

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  EN_TALLER
  CANCELADA
  NO_ASISTIO
}

enum EstadoServicio {
  RECEPCION
  EN_SERVICIO
  EN_DIAGNOSTICO
  ESPERA_REPUESTOS
  EN_REPARACION
  LISTO_ENTREGA
  FINALIZADO
  CANCELADO
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

enum EstadoChecklist {
  OPTIMO
  REGULAR
  REQUIERE_CAMBIO
  NO_APLICA
}